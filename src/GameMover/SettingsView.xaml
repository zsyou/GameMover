<UserControl x:Class="GameMover.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="640">
    <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Add..." Command="{Binding AddLibraryCommand}" MinWidth="88" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Edit..." Command="{Binding EditLibraryCommand}" MinWidth="88" Margin="0,0,8,0" Padding="10,4"/>
            <Button Content="Remove" Command="{Binding RemoveLibraryCommand}" MinWidth="88" Padding="10,4"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Library folders" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                       Text="GameMover copies a manually added game into one of these folders, checks the copy, updates the Playnite install path, and only then removes the original folder."/>
            <ListBox ItemsSource="{Binding Settings.Libraries}"
                     SelectedItem="{Binding SelectedLibrary}"
                     DisplayMemberPath="DisplayLabel"
                     MinHeight="180"/>
            <TextBlock Margin="0,12,0,4" Text="Display name"/>
            <TextBox Text="{Binding SelectedLibrary.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,8,0,4" Text="Folder"/>
            <TextBox Text="{Binding SelectedLibrary.Path, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel>
    </DockPanel>
</UserControl>
