<UserControl x:Class="GameMover.MoveGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="460" d:DesignWidth="680">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Start" Command="{Binding StartCommand}" MinWidth="108" Margin="0,0,8,0" Padding="12,6" IsDefault="True"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="108" Padding="12,6"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding GameName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,12,0,4" Text="Current folder"/>
                <TextBox Text="{Binding SourceDirectory, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                <TextBlock Margin="0,12,0,4" Text="Target library"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" MinWidth="96" Margin="8,0,0,0" Padding="10,4"/>
                    <ComboBox ItemsSource="{Binding Libraries}"
                              SelectedItem="{Binding SelectedLibrary}"
                              DisplayMemberPath="DisplayLabel"
                              MinHeight="26"
                              IsEnabled="{Binding IsIdle}"/>
                </DockPanel>
                <TextBlock Margin="0,4,0,0" Foreground="#888" TextWrapping="Wrap"
                           Visibility="{Binding HasNoLibraries, Converter={StaticResource BoolToVis}}"
                           Text="No saved libraries yet. Browse to a folder, or add libraries in GameMover settings."/>
                <TextBlock Margin="0,12,0,4" Text="Destination"/>
                <TextBox Text="{Binding DestinationPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                           Text="The original folder stays in place until the copy is checked and Playnite is updated."/>
                <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StageText}" FontWeight="SemiBold"/>
                    <ProgressBar Margin="0,8,0,8" Height="16" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}"/>
                    <TextBlock Text="{Binding CurrentFile}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <TextBlock Margin="0,4,0,0" Text="{Binding SizeText}"/>
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
